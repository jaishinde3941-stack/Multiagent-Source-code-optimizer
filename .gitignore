.coverage
htmlcov/

# Logs and runtime artifacts
logs/
*.log

# Generated optimization outputs & temp artifacts
MicroBenchmarks/Generated_optimisation/
*.o
*.obj
*.exe
*.bin
*.out
temp/
tmp/

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
